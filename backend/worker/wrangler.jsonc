{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dluh-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  // global_fetch_strictly_public: sem ele, chamar outro Worker desta conta pelo workers.dev (o repasse
  // da Evolution para o coda-proxy) volta 404.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers AI: transcrição dos áudios da assistente (Whisper).
  "ai": { "binding": "AI" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Limite do site dos clientes (/site/*): 8 chamadas por minuto por IP em cada rota.
  "ratelimits": [{ "name": "LIMITE_SITE", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  // Backup diário às 03:00 de Brasília (06:00 UTC) no Google Drive; às 09:00 de Brasília (12:00 UTC),
  // lembrete da entrada para quem tem pedido em até 3 dias (src/lembretes.js).
  "triggers": { "crons": ["0 6 * * *", "0 12 * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "dluh-festas",
    // Chave pública do app web (a mesma que está no site); não é segredo.
    "FIREBASE_API_KEY": "AIzaSyCV7LcTZmCE9MpezCvBah0hHQ245WYcixs",
    "SISTEMA_EMAIL": "sistema@dluh-festas.firebaseapp.com",
    "INFINITEPAY_HANDLE": "dluh_festas",
    // Telas que podem chamar a API (separadas por vírgula).
    "ORIGENS": "https://www.dluhfestas.com,https://dluhfestas.com,https://sitedluh.github.io,https://oikky.github.io,http://localhost:8000,http://127.0.0.1:8000",
    // ── Integrações (vazias = desligadas; ver README) ──
    // Google Drive e Agenda: ID da pasta do Drive e da agenda ("primary" = agenda principal da conta).
    "GOOGLE_DRIVE_PASTA": "1HZd4xLWZ8U9CmYI76evk6s8ZEUAcnsZ0",
    "GOOGLE_AGENDA_ID": "primary",
    // Evolution API: endereço público (túnel) e nome da instância; número da loja que recebe os avisos.
    "EVOLUTION_URL": "https://desktop-uu44p04.tail79b93c.ts.net",
    "EVOLUTION_INSTANCE": "dluh",
    "WHATSAPP_LOJA": "120363428834894870@g.us",
    // Assistente (Claude) no WhatsApp da Meta: ID do número na Meta e quem pode falar com ela
    // (separados por vírgula, com DDD). Vazio = desligada.
    "META_PHONE_ID": "512497525269120",
    "IA_NUMEROS": "5538999540665,5538997457788",
    // Telegram: grupo da equipe (supergrupo com tópicos) e o número de cada tópico.
    "TELEGRAM_CHAT": "-1004334694564",
    "TELEGRAM_TOPICOS": "pendentes:6,confirmados:4,pagamentos:8,ia:174",
    // Alexa na cozinha (src/alexa.js): ID da skill (amzn1.ask.skill.…) e o ID do Echo no Voice Monkey
    // que fala quando um pedido entra na fila. Vazios = desligados.
    "ALEXA_SKILL_ID": "amzn1.ask.skill.22ac3f92-d68f-4dfb-b7aa-adf53cdd361f",
    "VOICEMONKEY_DEVICE": "alexa-de-ikky-xg7ad"
  }
  // Segredos (`npx wrangler secret put <NOME>`): SISTEMA_SENHA; GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // GOOGLE_REFRESH_TOKEN; EVOLUTION_KEY; TURNSTILE_SECRET (opcional: liga o anti-robô do site); META_TOKEN, META_APP_SECRET, META_VERIFY, ANTHROPIC_API_KEY;
  // EVOLUTION_WEBHOOK_TOKEN (fim da URL /webhook/evolution/<token>) e EVOLUTION_REPASSE (o webhook que
  // a Evolution usava antes, com o token dele — por isso é segredo): o que não é da assistente segue para lá.
  // TELEGRAM_TOKEN (do @BotFather) e TELEGRAM_WEBHOOK_TOKEN (o secret_token do setWebhook).
  // VOICEMONKEY_TOKEN (Voice Monkey → API): o aviso falado da cozinha.
}
