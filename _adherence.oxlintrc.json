        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|subtitle|children|footer|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, subtitle, children, footer, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|qty|note|topper|price|key|ref|className|style|children)$/]",
        "message": "<OrderItem> doesn't accept that prop. Declared props: name, qty, note, topper, price."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onClear|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: value, onChange, onClear, placeholder, style."
