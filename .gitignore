# Fonte das skills = .agents/skills/. A pasta .claude/skills/ é derivada (symlinks que o
# Git no Windows resolve em cópias) — regenere com os comandos documentados no CLAUDE.md:
#   npx skills@latest add emilkowalski/skills
#   npx impeccable install
.claude/skills/*
# Skills escritas para este projeto (não vêm de npx skills)
!.claude/skills/nota-erp4me/

# Binários da engine do impeccable (~15 MB, reinstaláveis)
.agents/skills/impeccable/scripts/bin/

# Configuração local do Claude Code (específica da máquina)
.claude/settings.local.json

# Cache do Babel usado por tools/regen-bundle.js (baixado sob demanda)
tools/.cache/

# Artefatos do plugin do Playwright (logs de console, snapshots)
.playwright-mcp/

# Cópia do Coda para a migração (dados de clientes)
backend/.coda-export/

# referências do Behance (direitos dos autores; só consulta local)
site/_refs/
site/_ig/

# intermediários do traçado da marca (regeráveis pelos scripts de site/_logo)
site/_logo/*.npy
